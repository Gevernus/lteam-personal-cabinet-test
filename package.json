{
  "name": "lteam-personal-cabinet-test",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "test:mutation": "stryker run",
    "quality": "node scripts/check_quality.mjs",
    "validate": "npm run quality && npm run test:coverage && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "vue": "latest"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/mocha-runner": "^10.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/user-event": "^14.6.7",
    "@testing-library/vue": "^8.1.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/coverage-v8": "^5.0.1",
    "fast-check": "^4.10.1",
    "jsdom": "^30.1.0",
    "mocha": "^11.7.5",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "vitest-axe": "^0.1.0"
  }
}
